{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Tracker Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "logged_at",
    "payload"
  ],
  "properties": {
    "event_type": {
      "type": "string"
    },
    "logged_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
