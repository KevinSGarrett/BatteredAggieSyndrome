      "rounding": "NEAREST_INTEGER_METRE_ROUND_HALF_EVEN_OF_THE_EXACT_BINARY64_VALUE",
      "unit": "metre",
      "legs": "each oriented team's own later-observed reference origin (its provider team location) to the game's later-observed venue coordinate; identical coordinates give 0",
