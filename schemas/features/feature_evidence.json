{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeatureEvidence",
  "type": "object",
  "required": [
    "evidence_id",
    "feature_or_family_id",
    "target_id",
    "evidence_type",
    "data_snapshot_id",
    "evaluation_plan_id",
    "result_status"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "feature_or_family_id": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "evidence_type": {
      "type": "string"
    },
    "data_snapshot_id": {
      "type": "string"
    },
    "evaluation_plan_id": {
      "type": "string"
    },
    "metric_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "metric_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "result_status": {
      "enum": [
        "PENDING",
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "protected_test_used": {
      "type": "boolean"
    }
  }
}
