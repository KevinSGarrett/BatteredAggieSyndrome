{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batteredaggiesyndrome.local/schemas/instruction-manifest-v2.json",
  "title": "BAS Autonomous Instruction Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "instruction_pack_version",
    "artifact_version",
    "release_date",
    "project",
    "canonical_repository_windows",
    "entrypoint",
    "final_numbered_wave",
    "wave_26_allowed",
    "external_activation_state",
    "files",
    "coverage",
    "integrity_rule"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "instruction_pack_version": {"const": "2.0.0"},
    "artifact_version": {"const": "2.0.0"},
    "release_date": {"type": "string", "format": "date"},
    "project": {"const": "Battered Aggie Syndrome / Aggie Analytics Engine"},
    "canonical_repository_windows": {"const": "C:\\BatteredAggieSyndrome"},
    "entrypoint": {"const": "instructions/START_HERE.md"},
    "final_numbered_wave": {"const": "W25"},
    "wave_26_allowed": {"const": false},
    "external_activation_state": {"type": "object"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose", "authority", "read_tier", "when_to_read", "agent_roles", "dependencies", "version", "canonical_topic", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^instructions/"},
          "purpose": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "read_tier": {"type": "string", "minLength": 1},
          "when_to_read": {"type": "string", "minLength": 1},
          "agent_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "version": {"const": "2.0.0"},
          "canonical_topic": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "coverage": {"type": "object"},
    "integrity_rule": {"type": "string", "minLength": 1}
  }
}
