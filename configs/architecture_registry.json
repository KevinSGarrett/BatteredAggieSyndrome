{
  "schema_version": 1,
  "architecture_version": "w10-v1.0",
  "style": "offline_first_modular_monolith",
  "deployment_default": "single_local_repository_with_batch_jobs_and_snapshot_serving",
  "principles": [
    "point_in_time_gateway_required",
    "immutable_raw_evidence",
    "derived_state_is_versioned",
    "training_inference_feature_contract_parity",
    "research_plane_isolated_from_protected_production_governance",
    "llm_not_required_for_core_forecast_runtime",
    "snapshot_serving_over_synchronous_feature_model_execution",
    "national_foundation_plus_tamu_specialization",
    "future_live_plane_isolated_from_pregame",
    "canonical_identity_is_separate_from_source_identity",
    "append_only_entity_resolution_decisions"
  ],
  "data_zones": [
    {
      "id": "RAW",
      "order": 1,
      "mutable": false,
      "purpose": "exact external payloads/files plus retrieval evidence"
    },
    {
      "id": "QUARANTINE",
      "order": 2,
      "mutable": false,
      "purpose": "invalid/ambiguous evidence awaiting resolution"
    },
    {
      "id": "CANONICAL",
      "order": 3,
      "mutable": false,
      "purpose": "versioned normalized entities and observations"
    },
    {
      "id": "PIT_STATE",
      "order": 4,
      "mutable": false,
      "purpose": "as-of eligible state snapshots"
    },
    {
      "id": "FEATURES",
      "order": 5,
      "mutable": false,
      "purpose": "derived point-in-time features with lineage"
    },
    {
      "id": "TRAINING",
      "order": 6,
      "mutable": false,
      "purpose": "versioned training/evaluation matrices and labels"
    },
    {
      "id": "MODEL_ARTIFACTS",
      "order": 7,
      "mutable": false,
      "purpose": "model/calibration artifacts and metadata"
    },
    {
      "id": "FORECAST_SNAPSHOTS",
      "order": 8,
      "mutable": false,
      "purpose": "immutable prediction products"
    }
  ],
  "components": [
    {
      "id": "CMP-001",
      "name": "source_adapters",
      "plane": "evidence",
      "status": "LOGICAL_BOUNDARY",
      "imports": [],
      "execution_lanes": [
        "OFFLINE_BATCH",
        "FORECAST_REFRESH"
      ],
      "llm_policy": "OPTIONAL_ASSISTIVE_ONLY",
      "production_forecast_path": true,
      "responsibility": "provider-specific acquisition and source envelopes"
    },
    {
      "id": "CMP-002",
      "name": "raw_evidence_store",
      "plane": "evidence",
      "status": "LOGICAL_BOUNDARY",
      "imports": [],
      "execution_lanes": [
        "OFFLINE_BATCH",
        "FORECAST_REFRESH"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": true,
      "responsibility": "immutable native payload/file storage, hashes and retrieval metadata"
    },
    {
      "id": "CMP-003",
      "name": "validation_quarantine",
      "plane": "evidence",
      "status": "LOGICAL_BOUNDARY",
      "imports": [
        "CMP-002"
      ],
      "execution_lanes": [
        "OFFLINE_BATCH",
        "FORECAST_REFRESH"
      ],
      "llm_policy": "OPTIONAL_ASSISTIVE_ONLY",
      "production_forecast_path": true,
      "responsibility": "contract validation, findings and quarantine"
    },
    {
      "id": "CMP-004",
      "name": "canonicalization_entity_resolution",
      "plane": "evidence",
      "status": "LOGICAL_BOUNDARY",
      "imports": [
        "CMP-003"
      ],
      "execution_lanes": [
        "OFFLINE_BATCH",
        "FORECAST_REFRESH"
      ],
      "llm_policy": "OPTIONAL_ASSISTIVE_ONLY",
      "production_forecast_path": true,
      "responsibility": "stable canonical identities, source mappings, evidence identity hierarchy, append-only resolution decisions and effective-dated normalized observations"
    },
    {
      "id": "CMP-005",
      "name": "pit_state",
      "plane": "state",
      "status": "LOGICAL_BOUNDARY",
      "imports": [
        "CMP-004"
      ],
      "execution_lanes": [
        "OFFLINE_BATCH",
        "FORECAST_REFRESH"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": true,
      "responsibility": "bitemporal as-of reconstruction, temporal eligibility and immutable cutoff lineage gateway",
      "temporal_contract_ref": "configs/temporal_registry.json",
      "protected_gateway": true
    },
    {
      "id": "CMP-006",
      "name": "feature_factory",
      "plane": "feature_model",
      "status": "LOGICAL_BOUNDARY",
      "imports": [
        "CMP-005"
      ],
      "execution_lanes": [
        "OFFLINE_BATCH",
        "FORECAST_REFRESH"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": true,
      "responsibility": "versioned PIT-safe feature construction, screening/lifecycle lineage and target-specific feature contracts",
      "pit_gateway_required": true,
      "feature_contract_ref": "configs/feature_lifecycle_registry.json"
    },
    {
      "id": "CMP-007",
      "name": "national_modeling",
      "plane": "feature_model",
      "status": "LOGICAL_BOUNDARY",
      "imports": [
        "CMP-006"
      ],
      "execution_lanes": [
        "OFFLINE_BATCH",
        "FORECAST_REFRESH"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": true,
      "responsibility": "national foundation training/inference and uncertainty representations"
    },
    {
      "id": "CMP-008",
      "name": "tamu_specialization",
      "plane": "forecast",
      "status": "FROZEN_W14_CONTRACT",
      "imports": [
        "CMP-005",
        "CMP-006",
        "CMP-007"
      ],
      "execution_lanes": [
        "OFFLINE_BATCH",
        "FORECAST_REFRESH"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": true,
      "responsibility": "A&M high-resolution state overlay and empirically gated specialization relative to national foundation; no-adjustment baseline is mandatory",
      "contract_ref": "configs/tamu_specialization_registry.json"
    },
    {
      "id": "CMP-009",
      "name": "forecast_assembly",
      "plane": "forecast",
      "status": "LOGICAL_BOUNDARY",
      "imports": [
        "CMP-007",
        "CMP-008",
        "CMP-012"
      ],
      "execution_lanes": [
        "FORECAST_REFRESH"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": true,
      "responsibility": "coherent joint outcome distribution, scenarios and uncertainty assembly"
    },
    {
      "id": "CMP-010",
      "name": "bas_analytics",
      "plane": "forecast",
      "status": "LOGICAL_BOUNDARY",
      "imports": [
        "CMP-005",
        "CMP-009"
      ],
      "execution_lanes": [
        "OFFLINE_BATCH",
        "FORECAST_REFRESH"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": true,
      "responsibility": "scientific BAS probabilities relative to leakage-safe expected performance"
    },
    {
      "id": "CMP-011",
      "name": "evaluation_promotion",
      "plane": "feature_model",
      "status": "LOGICAL_BOUNDARY",
      "imports": [
        "CMP-006",
        "CMP-007",
        "CMP-008",
        "CMP-009",
        "CMP-010"
      ],
      "execution_lanes": [
        "OFFLINE_BATCH"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": false,
      "responsibility": "protected walk-forward scoring and champion/challenger gate"
    },
    {
      "id": "CMP-012",
      "name": "model_registry",
      "plane": "feature_model",
      "status": "LOGICAL_BOUNDARY",
      "imports": [],
      "execution_lanes": [
        "OFFLINE_BATCH",
        "FORECAST_REFRESH"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": true,
      "responsibility": "immutable model artifact metadata and approved champion/rollback references"
    },
    {
      "id": "CMP-013",
      "name": "forecast_snapshot_publication",
      "plane": "serving",
      "status": "LOGICAL_BOUNDARY",
      "imports": [
        "CMP-009",
        "CMP-010"
      ],
      "execution_lanes": [
        "FORECAST_REFRESH"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": true,
      "responsibility": "immutable forecast product artifact and lineage publication"
    },
    {
      "id": "CMP-014",
      "name": "read_only_serving",
      "plane": "serving",
      "status": "LOGICAL_BOUNDARY",
      "imports": [
        "CMP-013"
      ],
      "execution_lanes": [
        "SERVING_READ"
      ],
      "llm_policy": "OPTIONAL_EXPLANATION_ONLY",
      "production_forecast_path": false,
      "responsibility": "dashboard/API/report reads of immutable forecast snapshots"
    },
    {
      "id": "CMP-015",
      "name": "research_experimentation",
      "plane": "research",
      "status": "LOGICAL_BOUNDARY",
      "imports": [
        "CMP-006",
        "CMP-011"
      ],
      "execution_lanes": [
        "RESEARCH"
      ],
      "llm_policy": "OPTIONAL_ASSISTIVE_ONLY",
      "production_forecast_path": false,
      "responsibility": "isolated hypotheses, challenger artifacts and research proposals"
    },
    {
      "id": "CMP-016",
      "name": "orchestration_monitoring",
      "plane": "ops",
      "status": "LOGICAL_BOUNDARY",
      "imports": [],
      "execution_lanes": [
        "OFFLINE_BATCH",
        "FORECAST_REFRESH",
        "RESEARCH"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": false,
      "responsibility": "scheduling, retries, state observation and run lineage; framework deferred"
    },
    {
      "id": "CMP-017",
      "name": "future_live_ingame",
      "plane": "future_live",
      "status": "DEFERRED",
      "imports": [
        "CMP-007"
      ],
      "execution_lanes": [
        "FUTURE_LIVE"
      ],
      "llm_policy": "FORBIDDEN",
      "production_forecast_path": false,
      "responsibility": "future chronological live replay/inference isolated from pregame inputs"
    }
