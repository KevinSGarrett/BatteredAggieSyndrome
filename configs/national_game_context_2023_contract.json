      "radius_m": "6371008.8",
      "formula": "2 * R * asin(min(1, sqrt(sin^2(dphi / 2) + cos(phi1) * cos(phi2) * sin^2(dlambda / 2))))",
      "longitude_wrap": "dlambda is the raw longitude difference; sin^2(dlambda / 2) is 2*pi periodic, so the antimeridian needs no special case",
