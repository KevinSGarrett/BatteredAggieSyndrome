{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/bas/jira-traceability.schema.json",
  "title": "BAS Jira Issue Source Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jira_key",
    "internal_ids",
    "requirements",
    "adrs",
    "acceptance_controls",
    "source_documents",
    "dependencies",
    "affected_components",
    "evidence",
    "integration"
  ],
  "properties": {
    "jira_key": {
      "type": "string",
      "pattern": "^BAT-[1-9][0-9]*$"
    },
    "internal_ids": {
      "type": "object",
      "properties": {
        "handoff": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^HANDOFF-[0-9]{3}$"
          }
        },
        "epics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^EPIC-[0-9]{3}$"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3}$"
          }
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REQ-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ADR-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "acceptance_controls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "source_documents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "affected_components": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "integration": {
      "type": "object",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        },
        "pull_request": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
