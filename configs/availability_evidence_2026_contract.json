    "match": "identity.state",
    "values": [
     "RESOLVED_NAME_AND_JERSEY_AGREE",
     "RESOLVED_UNIQUE_NAME_JERSEY_NOT_STATED",
     "UNRESOLVED_JERSEY_SHARED_BY_SEVERAL_PLAYERS",
     "UNRESOLVED_NAME_AND_JERSEY_POINT_AT_DIFFERENT_PLAYERS",
     "UNRESOLVED_NO_ROSTER_ROW_MATCHES"
    ]
   },
   "--person-id": {
    "grains": [
     "statement"
    ],
    "grammar": "^(CFBD:[0-9]{1,18}|OFFICIAL:[^:]{1,100}:[0-9]{4}:[0-9]{1,6})$",
    "match": "identity.canonical_player_id"
   },
   "--policy-id": {
    "grains": [
     "opportunity",
     "policy"
    ],
    "grammar": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
    "match": {
     "opportunity": "governing_policy",
     "policy": "policy_id"
    }
   },
   "--policy-season": {
    "grains": [
     "policy"
    ],
    "grammar": "^[0-9]{4}$",
    "match": "policy_season"
   },
   "--presence": {
    "grains": [
     "statement"
    ],
    "grammar": "ENUM",
    "match": "presence",
    "values": [
     "PUBLISHED_EMPTY",
     "PUBLISHED_VALUE"
    ]
   },
   "--published-name": {
    "grains": [
     "statement"
    ],
    "grammar": "LITERAL_TEXT",
    "match": "player_name"
   },
   "--reported-status": {
    "grains": [
     "statement"
    ],
    "grammar": "LITERAL_TEXT",
    "match": "exact_status_text"
   },
   "--season": {
    "grains": [
     "statement",
     "opportunity"
    ],
    "grammar": "^[0-9]{4}$",
    "match": {
     "opportunity": "SCHEDULE_SEASON_2026",
     "statement": "contest.season"
    }
   },
   "--source-sha256": {
    "grains": [
     "statement",
     "policy"
    ],
    "grammar": "^[0-9a-f]{64}$",
    "match": {
     "policy": "source_sha256",
     "statement": "source_sha256"
    }
   },
   "--stage": {
    "grains": [
     "statement"
    ],
    "grammar": "ENUM",
    "match": "stage",
    "values": [
     "initial_status",
     "update_1_status",
     "update_2_status",
     "game_day_status"
    ]
   },
   "--statement-id": {
    "grains": [
     "statement"
    ],
    "grammar": "^[1-9][0-9]{0,18}$",
    "match": "availability_row_id"
   },
   "--team": {
    "grains": [
     "statement",
     "opportunity"
    ],
    "grammar": "LITERAL_TEXT",
    "match": "program"
   }
