{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoricalWeightingCandidate",
  "type": "object",
  "required": [
    "candidate_id",
    "name",
    "state",
    "production_selected"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^HW-[0-9]{3}$"
    },
    "name": {
      "type": "string"
    },
    "state": {
      "enum": [
        "BASELINE",
        "EXPERIMENTAL",
        "REJECTED"
      ]
    },
    "production_selected": {
      "const": false
    },
    "numeric_parameters": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
