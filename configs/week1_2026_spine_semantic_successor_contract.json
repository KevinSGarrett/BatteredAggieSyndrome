          "AWAY",
          "NEUTRAL",
          "UNKNOWN"
        ],
        "may_be_admitted_without_venue_identity": true,
        "derived_from": "PREDECESSOR_SITE_ORIENTATION_AND_SITE_STATE"
      },
      {
        "domain": "VENUE_IDENTITY",
        "admissible_values": [
          "AUTHORITATIVE_VENUE_ID",
          "SOURCE_EVIDENCE_ABSENT"
        ],
        "may_be_admitted_from_site_orientation_alone": false,
        "derived_from": "PREDECESSOR_VENUE_IDENTITY_AND_VENUE_IDENTITY_STATE"
      },
      {
        "domain": "VENUE_COORDINATES",
        "admissible_values": [
          "AUTHORITATIVE_COORDINATES",
          "CANDIDATE_ONLY",
          "SOURCE_EVIDENCE_ABSENT"
        ],
