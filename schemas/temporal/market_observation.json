    },
    "provider": {
      "type": "string"
    },
    "market_type": {
      "type": "string"
    },
    "side": {
      "type": "string"
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "price": {
      "type": [
        "number",
        "null"
      ]
    },
    "source_reported_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_known_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "snapshot_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_spread_convention": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
