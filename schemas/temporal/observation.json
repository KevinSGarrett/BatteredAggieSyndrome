{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aggie://schemas/temporal/observation/v1",
  "title": "TemporalObservation",
  "type": "object",
  "required": [
    "observation_id",
    "source_observation_id",
    "domain",
    "retrieved_at",
    "temporal_policy_version"
  ],
  "properties": {
    "observation_id": {
      "type": "string"
    },
    "source_observation_id": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_reported_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_known_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "prediction_eligible_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "retrospective_flag": {
      "type": "boolean"
    },
    "corroborated_for_historical_use": {
      "type": "boolean"
    },
    "temporal_class": {
      "type": "string"
    },
    "temporal_policy_version": {
      "type": "string"
    },
    "supersedes_observation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_ref": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
