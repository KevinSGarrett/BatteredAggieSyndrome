{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HPOStudySpec",
  "type": "object",
  "required": [
    "study_id",
    "candidate_family",
    "search_space_version",
    "development_split",
    "objective_metrics",
    "trial_budget",
    "paid_compute_approved"
  ],
  "properties": {
    "study_id": {
      "type": "string"
    },
    "candidate_family": {
      "type": "string"
    },
    "search_space_version": {
      "type": "string"
    },
    "development_split": {
      "enum": [
        "SPLIT-DEV-HIST",
        "SPLIT-DEV-SEL"
      ]
    },
    "objective_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "trial_budget": {
      "type": "integer",
      "minimum": 1
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1
    },
    "paid_compute_approved": {
      "type": "boolean"
    },
    "protected_metrics_allowed": {
      "const": false
    }
  }
}
