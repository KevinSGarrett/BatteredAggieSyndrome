{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Promotion Review Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "result_id",
    "replay_id",
    "judging_rule_seal_hash",
    "development_evidence_hash",
    "artifact_manifest_hash",
    "requested_state"
  ],
  "properties": {
    "experiment_id": {
      "type": "string"
    },
    "result_id": {
      "type": "string"
    },
    "replay_id": {
      "type": "string"
    },
    "judging_rule_seal_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "development_evidence_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested_state": {
      "const": "PROMOTION_REVIEW_REQUIRED"
    },
    "notes": {
      "type": "string"
    }
  }
}
