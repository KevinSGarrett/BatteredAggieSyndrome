    {
      "case_id": "game-401628348-game-info",
      "category": "game_information",
      "domains": ["venue", "officials", "weather", "attendance"],
      "instruction": "Extract the game-information fields for the McNeese at Texas A&M game from every supplied line.",
      "source": "official_gamebook_pdf",
      "extractor": {"type": "pdf_page_lines", "page": 1, "start_line": 4, "end_line": 10},
      "facts": [
        {"field": "venue", "regex": "Site: .* \\(([^)]+)\\)"},
        {"field": "attendance", "regex": "Attendance: ([0-9,]+)", "transform": "INT_COMMAS"},
        {"field": "temperature_f", "regex": "Temperature: ([0-9]+)", "transform": "INT"},
        {"field": "wind", "regex": "Wind: (.*?)   Weather:"},
        {"field": "weather", "regex": "Weather: ([^\\n]+)"},
        {"field": "referee", "regex": "Referee: (.*?)   Line Judge:"},
        {"field": "line_judge", "regex": "Line Judge: (.*?)   Side Judge:"},
        {"field": "side_judge", "regex": "Side Judge: (.*?)   Umpire:"},
        {"field": "umpire", "regex": "Umpire: ([^\\n]+)"},
        {"field": "back_judge", "regex": "Back Judge: (.*?)   Score Keeper:"},
        {"field": "linesman", "regex": "Linesman: (.*?)   Field Judge:"},
        {"field": "field_judge", "regex": "Field Judge: ([^\\n]+)"}
      ]
    },
    {
      "case_id": "game-401628348-drive",
      "category": "drive_summary",
      "domains": ["drives"],
      "instruction": "Extract the first Texas A&M drive row, the row beginning 1st A&M25 15:00.",
      "source": "official_gamebook_pdf",
      "extractor": {"type": "pdf_page_lines", "page": 6, "start_line": 15, "end_line": 17},
      "facts": [
        {"field": "quarter", "regex": "^(1st) A&M25", "transform": "STRING"},
        {"field": "start_spot", "regex": "^1st (A&M25)"},
        {"field": "start_clock", "regex": "^1st A&M25 ([0-9:]+)"},
        {"field": "end_spot", "regex": "^1st A&M25 [0-9:]+ KO ([A-Z&0-9]+)"},
        {"field": "result", "regex": "^1st A&M25 [0-9:]+ KO [A-Z&0-9]+ [0-9:]+ ([A-Z]+)"},
        {"field": "plays", "regex": " ([0-9]+)-75 ", "transform": "INT"},
        {"field": "yards", "regex": " 5-([0-9]+) ", "transform": "INT"},
        {"field": "elapsed", "regex": " ([0-9]{2}:[0-9]{2})$"}
      ]
    },
    {
      "case_id": "game-401628348-team-box",
      "category": "team_box_score",
      "domains": ["team_box_scores"],
      "instruction": "Extract Texas A&M team statistics only; A&M is the second numeric column and means Texas A&M.",
      "source": "official_gamebook_pdf",
      "extractor": {"type": "pdf_page_lines", "page": 2, "start_line": 0, "end_line": 20},
      "facts": [
        {"field": "team", "value": "Texas A&M", "require_regex": "Team Statistics MCN A&M"},
        {"field": "first_downs", "regex": "FIRST DOWNS [0-9]+ ([0-9]+)", "transform": "INT"},
        {"field": "rushing_yards", "regex": "NET YARDS RUSHING [0-9]+ ([0-9]+)", "transform": "INT"},
        {"field": "passing_yards", "regex": "NET YARDS Passing [0-9]+ ([0-9]+)", "transform": "INT"},
        {"field": "total_yards", "regex": "TOTAL OFFENSE YARDS [0-9]+ ([0-9]+)", "transform": "INT"},
        {"field": "offensive_plays", "regex": "Plays [0-9]+ ([0-9]+)", "transform": "INT"}
      ]
    },
    {
      "case_id": "game-401628348-player-box",
      "category": "player_box_score",
      "domains": ["player_box_scores"],
      "instruction": "Extract the Texas A&M passing row for Weigman,Conner only.",
      "source": "official_gamebook_pdf",
      "extractor": {"type": "pdf_page_lines", "page": 3, "start_line": 2, "end_line": 10},
      "facts": [
        {"field": "team", "value": "Texas A&M", "require_regex": "McNeese Texas A&M"},
        {"field": "player", "regex": "(Weigman,Conner) [0-9]"},
        {"field": "completions", "regex": "Weigman,Conner ([0-9]+)", "transform": "INT"},
        {"field": "attempts", "regex": "Weigman,Conner [0-9]+ ([0-9]+)", "transform": "INT"},
        {"field": "passing_yards", "regex": "Weigman,Conner [0-9]+ [0-9]+ ([0-9]+)", "transform": "INT"},
        {"field": "passing_touchdowns", "regex": "Weigman,Conner [0-9]+ [0-9]+ [0-9]+ ([0-9]+)", "transform": "INT"},
        {"field": "interceptions", "regex": "Weigman,Conner [0-9]+ [0-9]+ [0-9]+ [0-9]+ ([0-9]+)", "transform": "INT"}
      ]
    },
    {
      "case_id": "game-401628348-roster-starter",
      "category": "roster_starter",
      "domains": ["roster_starter_facts"],
      "instruction": "Extract the Texas A&M starter Weigman,Conner only; A&M means Texas A&M.",
      "source": "official_boxscore_html",
      "extractor": {"type": "html_text_range", "start": "Starters\nMCN\n#", "end": "Player Participation"},
      "facts": [
        {"field": "team", "value": "Texas A&M", "require_regex": "A&M\\n#\\nPlayer\\nPos\\."},
        {"field": "player", "regex": "\\n15\\n(Weigman,Conner)\\nQB\\n"},
        {"field": "jersey", "regex": "\\n(15)\\nWeigman,Conner\\nQB\\n", "transform": "INT"},
        {"field": "position", "regex": "\\n15\\nWeigman,Conner\\n(QB)\\n"},
        {"field": "starter_status", "value": true, "require_regex": "Starters[\\s\\S]*Weigman,Conner"}
      ]
    },
    {
      "case_id": "game-401628348-source-metadata",
      "category": "source_metadata",
      "domains": ["source_metadata"],
      "instruction": "Normalize source_uri to source_url and retrieved_at to acquired_at_utc; copy the other requested manifest fields directly.",
      "source": "official_boxscore_manifest",
      "extractor": {"type": "json_fields", "fields": ["dataset", "metadata.game_id", "raw_sha256", "retrieved_at", "snapshot_id", "source_id", "source_uri"]},
      "facts": [
        {"field": "source_id", "json_path": "source_id"},
        {"field": "dataset", "json_path": "dataset"},
        {"field": "game_id", "json_path": "metadata.game_id"},
        {"field": "source_url", "json_path": "source_uri"},
        {"field": "acquired_at_utc", "json_path": "retrieved_at"},
        {"field": "raw_sha256", "json_path": "raw_sha256"},
        {"field": "snapshot_id", "json_path": "snapshot_id"}
      ]
    }
  ],
