  "conservative_bound_policy": {
    "date_only_rule": {
      "applies_when": "The only temporal evidence for a contest is a calendar date, observed as a midnight UTC sentinel in the spine start field.",
      "earliest_possible_start_offset_days": -1,
      "latest_possible_completion_offset_days": 2,
      "logical_guarantee": "A recorded calendar date may be a local date, so the true contest window lies within one day either side of it. Adding one further day covers the longest possible contest including overtime and weather suspension. A prior contest is therefore guaranteed complete before a target contest starts only when the target date is at least three days after the prior date.",
      "recorded_date_may_be_local_or_utc": true,
      "required_separation_days": 3
    },
    "label": "THIS_IS_A_BOUND_NOT_AN_OBSERVED_FINAL_WHISTLE",
    "policy_id": "BAT-666-CONSERVATIVE-COMPLETION-BOUND-V1",
    "precommitted": true,
    "published_start_instant_rule": {
      "applies_when": "The spine carries a non-midnight UTC start instant for the contest.",
      "logical_guarantee": "A published start instant plus twelve hours bounds any contest including overtime, television delay and weather suspension. A prior contest is guaranteed complete before a target contest starts when the prior start instant plus twelve hours does not exceed the target start instant.",
      "maximum_contest_duration_hours": 12
    },
    "rejected_assumptions": [
      "Treating the retrieval time of a historical capture as the moment the value became known.",
      "Treating a recorded calendar date as an exact kickoff instant.",
      "Assuming that a prior contest on the immediately preceding calendar day had finished before a target contest began.",
      "Imputing a poll publication instant from a poll week ordinal."
    ]
  },
