{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experiment Store Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "spec_sha256",
    "payload",
    "created_at"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[0-9a-f]{16,64}$"
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
