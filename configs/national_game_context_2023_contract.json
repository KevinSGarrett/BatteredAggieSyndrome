    "date_window": {
      "rule": "the provider start instant is compatible with the accepted parent local date D when it lies in [D 00:00 at UTC+14:00, D 24:00 at UTC-12:00), i.e. [D-1 10:00Z, D+1 12:00Z); no timezone is inferred",
