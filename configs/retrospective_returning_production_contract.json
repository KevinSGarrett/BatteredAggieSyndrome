  "feature_contract": {
    "roster_continuity": {
      "returning_roster_count": "count of canonical players present for the same canonical team in both prior and target season rosters",
      "prior_roster_count": "distinct canonical players on the prior-season team roster",
      "current_roster_count": "distinct canonical players on the target-season team roster",
      "departed_roster_count": "prior roster players absent from the same team in the target season",
      "arrival_roster_count": "target roster players absent from the same team in the prior season",
      "roster_retention_rate": "returning_roster_count divided by prior_roster_count",
      "roster_arrival_rate": "arrival_roster_count divided by current_roster_count",
      "roster_jaccard": "returning_roster_count divided by the union of prior and target roster players"
    },
    "returning_production": {
      "formula": "sum prior-season source_value for players on the same target-season team roster divided by total prior-season team source_value",
      "category_stat_pairs": [
        ["interceptions", "INT"],
        ["passing", "YDS"],
        ["receiving", "REC"],
        ["receiving", "YDS"],
        ["rushing", "CAR"],
        ["rushing", "YDS"]
      ],
      "missingness": "NULL when a team/category/stat denominator is absent; never zero-fill absent evidence",
      "structural_zero": "A recorded zero denominator is not eligible for a share and remains null",
      "ratio_semantics": {
        "interceptions_INT_receiving_REC_rushing_CAR": "BOUNDED_NONNEGATIVE_COUNT_SHARE; returning subset divided by team total must remain in [0,1]",
        "passing_YDS_receiving_YDS_rushing_YDS": "SIGNED_EVENT_SUM_RATIO; negative player events can make the returning subset slightly exceed the net team total or become negative, so values are preserved without clipping and explicitly diagnosed"
