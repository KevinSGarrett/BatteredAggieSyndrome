{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aggie://schemas/features/schema_scan/w09-v1",
  "type": "object",
  "required": [
    "path",
    "format",
    "records_scanned",
    "fields"
  ],
  "properties": {
    "path": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "records_scanned": {
      "type": "integer",
      "minimum": 0
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field_path",
          "observed_type",
          "non_null",
          "missing"
        ],
        "properties": {
          "field_path": {
            "type": "string"
          },
          "observed_type": {
            "type": "string"
          },
          "non_null": {
            "type": "integer"
          },
          "missing": {
            "type": "integer"
          }
        }
      }
    }
  }
}
