   ],
   "publication": {
    "authority": "SOURCE_REPORTED_POSTING_CLAIM_NOT_FIRST_KNOWN_NOT_VERSION_SEAL_NOT_PIT",
    "disputed": "DISPUTED_AGAINST_PINNED_WITNESS",
    "rule": "An original publication_time_established claim is witnessed only when the later posting capture holds an INITIAL REPORT card for the row's initial_status stage whose game date (card footer and page heading year) equals the contest date, whose team column equals program_as_written and lists exactly one entry '<position> #<jersey> <player>' under the heading equal to the upper-cased status text, whose 'Report posted on <Weekday>, <Month> <D> at <h>:<mm><am|pm> ET' line has a consistent weekday and converts (US Eastern time, daylight time from the second Sunday of March 2:00 to the first Sunday of November 2:00) to publication_utc, and whose capture time is later than the claim. Every other row is PUBLICATION_TIME_UNKNOWN.",
    "unknown": "PUBLICATION_TIME_UNKNOWN",
    "update_cards": "an UPDATE REPORT card would be listed as a card kind; none is invented",
    "witnessed": "SOURCE_POSTING_CLAIM_WITNESSED_IN_LATER_CAPTURE"
   },
   "quarantine_flag": "IDENTITY_ONLY_FLAG_NOT_WHOLE_ROW_QUALIFICATION",
   "source_cell": {
    "compared_fields": [
     "source_sha256",
     "locator_prefix",
     "locator_stage",
     "stage",
     "conference",
     "report_vintage_retrieval_utc",
     "source_url",
     "embedded_in",
     "program_as_written",
     "date_as_written",
     "contest_label",
     "opponent_as_written",
     "jersey",
     "player_name",
     "exact_status_text",
     "presence"
    ],
    "consequence_of_dispute": "ORIGINAL_RETAINED_UNCHANGED_DISPUTE_VISIBLE_WITH_COMPETING_WITNESS_TEXT",
    "disputed": "DISPUTED_AGAINST_PINNED_WITNESS",
    "field_rules": {
     "conference": "equals the witness conference",
     "contest_label": "equals '<month>/<day>/<two-digit year> <raw Opponent>' (the retained producer label form)",
     "date_as_written": "contest.date_as_written equals the ISO date of the raw Date cell (M/D/YY or 'Ddd, Mon D, YYYY' with a consistent weekday)",
     "embedded_in": "equals the witness embedding page (null for the SEC capture)",
     "exact_status_text": "equals the raw stage cell",
     "jersey": "equals the raw Number cell (an empty cell is an empty string)",
     "locator_prefix": "row for the SEC capture, rows for the rendered JSON archives",
     "locator_stage": "the locator's stage token equals the row's stage",
     "opponent_as_written": "only when the contest claim carries it: equals the raw Opponent without a leading 'vs. ' or 'at '",
     "player_name": "equals the raw Player cell",
     "presence": "PUBLISHED_EMPTY exactly when the raw stage cell is '-', otherwise PUBLISHED_VALUE",
     "program_as_written": "equals the raw Team cell",
     "report_vintage_retrieval_utc": "equals the witness retrieval observation text",
     "source_url": "equals the witness source URL (null for the SEC capture)"
    },
    "locator": "^(row|rows)\\[([1-9][0-9]{0,5})\\]\\.(initial_status|update_1_status|update_2_status|game_day_status)$",
    "source_empty": "a raw '-' cell is SOURCE_EMPTY_CELL whichever original normalized representation (null or SEC UNKNOWN) the producer stored; the originals are served unchanged",
